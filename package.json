{
  "name": "diretta-scraper",
  "version": "0.2.1",
  "description": "Node/TypeScript backend: SBI Schedule/Monitoring/Matches APIs + diretta.it live scraper",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "generate": "openapi-typescript openapi/openapi.yaml -o src/sbi/generated/api-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run typecheck",
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "bump": "node scripts/bump-version.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
