# Server binding
HOST=127.0.0.1
PORT=8000

# Logging level: debug, info, warn, error, silent
LOG_LEVEL=info

# SBI upstream base URL (not hard-coded in source).
UPSTREAM_BASE_URL=https://bet-service-658489904938.europe-west6.run.app

# Application metadata served in /openapi.json
APP_NAME=SBI Backend APIs
APP_VERSION=0.1.5

# diretta.it scraper
# SQLite database file for scraped matches (defaults to data/diretta.db).
DIRETTA_DB=
# TTL of the in-memory matches cache, in seconds.
DIRETTA_CACHE_TTL=15

# Monitoring strategy: comma-separated major leagues to keep from the live feed.
# Each entry matches either the full tournament name (e.g. "ITALIA: Serie A") or
# its diretta.it id (e.g. "COuk57Ci"), exactly. Empty/unset falls back to the
# built-in top-5 leagues. Cups use stage-specific names/ids, so add them explicitly.
MONITOR_MAJOR_LEAGUES=
