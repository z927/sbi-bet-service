# Server binding
HOST=127.0.0.1
PORT=8000

# Logging level: debug, info, warn, error, silent
LOG_LEVEL=info

# SBI upstream base URL (not hard-coded in source).
UPSTREAM_BASE_URL=https://bet-service-658489904938.europe-west6.run.app

# Application metadata served in /openapi.json
APP_NAME=SBI Backend APIs
# Override opzionale della versione: default = "version" di package.json.
APP_VERSION=

# Supabase (obbligatorio)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# diretta.it scraper
# TTL of the in-memory matches cache, in seconds.
DIRETTA_CACHE_TTL=15

# Monitoring strategy: comma-separated major leagues to keep from the live feed.
# Each entry matches either the full tournament name (e.g. "ITALIA: Serie A") or
# its diretta.it id (e.g. "COuk57Ci"), exactly. Empty/unset falls back to the
# built-in major-league list (top European leagues + UEFA competitions, see
# src/services/strategies/major_leagues.ts). Setting this env REPLACES the whole
# default list.
MONITOR_MAJOR_LEAGUES=

# GCP Cloud Scheduler (auto-schedule).
# Project/region/job-id are injected at deploy time by CI; the target base URL is
# this service's own public URL (the scheduler job GETs /api/v1/monitor from it).
# Leave MONITOR_JOB_TARGET_BASE_URL empty to skip scheduler creation (local dev).
GCP_PROJECT_ID=
GCP_REGION=europe-west6
GCP_JOB_ID=bet-monitoring-matches-scheduler
MONITOR_JOB_TARGET_BASE_URL=
# Timezone used for the scheduler cron expression.
SCHEDULER_TIME_ZONE=Europe/Rome
# Minutes subtracted from each match start_time to compute beginMonitoringTime.
MONITOR_LEAD_MINUTES=0
# Minute step of the scheduler cron: the job fires every N minutes during the
# monitoring windows of the day's matches (e.g. "*/10 15-17,18-20 18 10 SUN").
SCHEDULER_CRON_STEP_MINUTES=10

# Monitoring signals
# Telegram configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Goal-over-0.5 signal: minimum touch ratio to fire the alert (>= threshold).
# First half uses first-half touches/minutes; second half uses only
# second-half touches over second-half elapsed minutes.
MONITOR_SIGNAL_GOAL_RATIO_THRESHOLD=0.7

# Win Rate shown in the Telegram alert message
MONITOR_SIGNAL_WIN_RATE=80
